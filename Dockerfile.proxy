# syntax=docker/dockerfile:1
FROM golang:1.26-alpine AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 GOOS=linux go build -trimpath -ldflags="-s -w" -o /out/kube-port-forward-proxy ./cmd/kube-port-forward-proxy

FROM scratch
COPY --from=build /out/kube-port-forward-proxy /kube-port-forward-proxy
USER 65532:65532
EXPOSE 1080
ENTRYPOINT ["/kube-port-forward-proxy"]
